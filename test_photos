// server.js - serverul local pentru SneakerReels AI
const express = require("express");
const multer = require("multer");
const { spawn } = require("child_process");
const fs = require("fs");
const path = require("path");

const app = express();
const PORT = 3000;

// foldere de lucru (se creeaza singure)
const uploadsDir = path.join(__dirname, "uploads");
const videosDir = path.join(__dirname, "videos");
fs.mkdirSync(uploadsDir, { recursive: true });
fs.mkdirSync(videosDir, { recursive: true });

// primirea pozelor: pastram extensia, acceptam doar jpg/png/webp
const storage = multer.diskStorage({
  destination: uploadsDir,
  filename: (req, file, cb) => {
    const ext = path.extname(file.originalname).toLowerCase();
    cb(null, Date.now() + "-" + Math.round(Math.random() * 1e9) + ext);
  }
});

const upload = multer({
  storage,
  limits: { files: 10, fileSize: 25 * 1024 * 1024 },
  fileFilter: (req, file, cb) => {
    cb(null, /\.(jpe?g|png|webp)$/i.test(file.originalname));
  }
});

// creeaza videoclipul cu FFmpeg
function buildReel(photos, outputFile) {
  return new Promise((resolve, reject) => {
    const SECONDS = 3.5;
    const FPS = 30;
    const FRAMES = Math.round(SECONDS * FPS);
    const FADE = 0.5;

    const args = ["-y", "-hide_banner", "-loglevel", "error", "-nostdin"];
    photos.forEach(p => args.push("-i", p));

    const filters = [];
    photos.forEach((p, i) => {
      filters.push(
        `[${i}:v]scale=2160:3840:force_original_aspect_ratio=increase,` +
        `crop=2160:3840,setsar=1,` +
        `zoompan=z='1+0.25*on/${FRAMES}':x='iw/2-(iw/zoom/2)':y='ih/2-(ih/zoom/2)':` +
        `d=${FRAMES}:s=1080x1920:fps=${FPS},format=yuv420p[v${i}]`
      );
    });

    let last = "v0";
    for (let i = 1; i < photos.length; i++) {
      const out = "x" + i;
      filters.push(
        `[${last}][v${i}]xfade=transition=fade:duration=${FADE}:offset=${i * (SECONDS - FADE)}[${out}]`
      );
      last = out;
    }

    args.push(
      "-filter_complex", filters.join(";"),
      "-map", `[${last}]`,
      "-c:v", "libx264",
      "-preset", "medium",
      "-crf", "20",
      "-pix_fmt", "yuv420p",
      "-r", String(FPS),
      "-movflags", "+faststart",
      outputFile
    );

    const ff = spawn("ffmpeg", args);
    let log = "";
    ff.stderr.on("data", d => {
      log = (log + d.toString()).slice(-4000);
    });
    ff.on("error", () => reject(new Error("Nu pot porni FFmpeg.")));
    ff.on("close", code => (code === 0 ? resolve() : reject(new Error(log))));
  });
}

// pagina principala
app.get("/", (req, res) => {
  res.sendFile(path.join(__dirname, "index.html"));
});

// videoclipurile gata facute
app.use("/videos", express.static(videosDir));

// generarea videoclipului
app.post("/generate", (req, res) => {
  upload.array("photos", 10)(req, res, async err => {
    if (err) {
      return res.status(400).json({ error: "Maxim 10 poze, fiecare sub 25 MB." });
    }

    const files = req.files || [];
    if (files.length === 0) {
      return res.status(400).json({
        error: "Nu am primit poze valide. Folosește fișiere .jpg, .png sau .webp."
      });
    }

    const style = req.body.style;
    const objective = req.body.objective;
    console.log(`Cerere noua: ${files.length} poze | stil: ${style} | obiectiv: ${objective}`);

    const fileName = "reel-" + Date.now() + ".mp4";
    const outputFile = path.join(videosDir, fileName);

    try {
      await buildReel(files.map(f => f.path), outputFile);
      console.log("Videoclip gata: " + fileName);
      res.json({ url: "/videos/" + fileName });
    } catch (e) {
      console.log("Eroare FFmpeg:\n" + e.message);
      res.status(500).json({ error: "Nu am putut crea videoclipul. Vezi detalii în terminal." });
    } finally {
      files.forEach(f => fs.unlink(f.path, () => {}));
    }
  });
});

app.listen(PORT, () => {
  console.log("SneakerReels AI funcționează!");
  console.log("Deschide în browser: http://localhost:" + PORT);
});